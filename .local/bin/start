#!/bin/bash

# Vykreslení menu najednou pomocí cat (čistší než opakované echo)
cat << "EOF"

#############################
#                           #
#    HOLA, VYBER SEZENÍ:    #
#                           #
#    Enter) SPUSTIT         #
#    R)     RESTARTOVAT     #
#    V)     VYPNOUT         #
#                           #
#############################
EOF

while true; do
    # -r zabrání interpretaci zpětných lomítek
    read -r -n 1 -s wm_choice

    # Převedení vstupu na malá písmena (funguje pak 'r' i 'R', 'v' i 'V')
    case "${wm_choice,,}" in
        "" | "s")
            echo -e "\nSpouštím Debian..."
            exec sway-run
            ;;
        "v" | "x")
            echo -e "\nVypínání..."
            sleep 1
            exec systemctl poweroff
            ;;
        "r")
            echo -e "\nRestart..."
            sleep 1
            exec systemctl reboot
            ;;
        *)
            echo "Zvolte jednu z možností (Enter, R, V)"
            ;;
    esac
done

#### END OF FILE ####
