#!/bin/bash

a="Okno nebo výběr"
b="Celá plocha"
ai="\0icon\x1fgnome-screenshot"
bi="\0icon\x1femblem-photos"

selected=$(echo -e "$a$ai\n$b$bi" | rofi -dmenu -i -config ~/.config/rofi/clouds.rasi -theme-str 'inputbar { enabled: false; }')
sleep 0.2
case $selected in
    "$a")
        grimshot --notify save anything;;
    "$b")
        grimshot --notify save output;;
       *)
        notify-send -t 1200 -i dialog-information "Přerušeno uživatelem"
esac

#### END OF FILE ####
